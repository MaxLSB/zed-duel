{
  "name": "zed-duel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/server/index.ts",
    "start": "node --import tsx src/server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "dev:peer": "vite --mode pages --host 0.0.0.0",
    "build:pages": "tsc --noEmit && vite build --mode pages --base=/zed-duel/",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "peerjs": "1.5.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "peer": "1.0.2",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0"
  }
}
