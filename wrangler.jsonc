{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zed-duel-signal",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGIN": "https://maxlsb.github.io" },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "SignalRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }],
  "ratelimits": [
    { "name": "REQUEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
  ],
  "env": {
    "test": {
      "name": "zed-duel-signal-test",
      "vars": { "ALLOWED_ORIGIN": "http://127.0.0.1:3180" },
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "SignalRoom" }] },
      "ratelimits": [
        { "name": "REQUEST_LIMITER", "namespace_id": "1002", "simple": { "limit": 1000, "period": 60 } },
      ],
    },
  },
}
